# Optional: CardSight AI API key for photo-based card identification
# Sign up at https://cardsight.ai/
CARDSIGHT_API_KEY=

# Kill switch: set to "true" to block all CardSight API calls (e.g. when monthly quota is exhausted)
# CARDSIGHT_DISABLED=true

# Optional: Bluesky credentials for sharing cards
# Generate an App Password in Bluesky Settings → Privacy and Security → App Passwords
BSKY_HANDLE=
BSKY_APP_PASSWORD=
